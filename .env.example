# Martol connection
MARTOL_WS_URL=wss://martol.plitix.com/api/rooms/<roomId>/ws
MARTOL_API_KEY=
MARTOL_MCP_URL=                  # Optional, derived from WS URL

# AI provider
AI_PROVIDER=anthropic            # "anthropic" or "openai"
AI_API_KEY=
AI_MODEL=                        # Optional, uses provider default
AI_BASE_URL=                     # Optional, for OpenAI-compatible APIs

# Agent behavior
AGENT_LABEL=claude:backend       # @mention trigger
CONTEXT_MESSAGES=50              # Rolling context window
RESPOND_MODE=mention             # "mention" or "all"
