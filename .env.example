# Martol connection
MARTOL_WS_URL=wss://martol.plitix.com/api/rooms/<roomId>/ws
MARTOL_API_KEY=

# Optional, derived from WS URL if omitted
MARTOL_MCP_URL=

# AI provider — "anthropic" or "openai"
AI_PROVIDER=anthropic
AI_API_KEY=

# Optional, uses provider default
AI_MODEL=

# Optional, for OpenAI-compatible APIs
AI_BASE_URL=

# Agent behavior
CONTEXT_MESSAGES=50
RESPOND_MODE=mention

# ── Profiles ────────────────────────────────────────────────
# To run multiple agents, create named profile files:
#   .env.claude   — python -m martol_agent --profile claude
#   .env.gpt      — python -m martol_agent --profile gpt
# Each profile file has the same format as this file.
# CLI flags override profile values.
