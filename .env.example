# Martol connection
MARTOL_WS_URL=wss://martol.plitix.com/api/rooms/<roomId>/ws
MARTOL_API_KEY=

# Or: path to file containing the API key (more secure)
MARTOL_API_KEY_FILE=

# Optional: HMAC secret for verifying server message integrity (R6)
# Set to the same value as HMAC_SIGNING_SECRET on the server
MARTOL_HMAC_SECRET=

# Optional, derived from WS URL if omitted
MARTOL_MCP_URL=

# AI provider — "anthropic" or "openai"
AI_PROVIDER=anthropic
AI_API_KEY=

# Optional, uses provider default
AI_MODEL=

# Optional, for OpenAI-compatible APIs
AI_BASE_URL=

# Agent behavior
CONTEXT_MESSAGES=50
RESPOND_MODE=mention

# Max LLM API calls per minute (default: 10)
LLM_RATE_LIMIT=10

# Context budgeting — controls system prompt size management
# Total system prompt character ceiling (default: 80000)
CONTEXT_BUDGET_CHARS=
# Max characters for the project brief section (default: 8000)
BRIEF_MAX_CHARS=

# ── Profiles ────────────────────────────────────────────────
# To run multiple agents, create named profile files:
#   .env.claude   — python -m martol_agent --profile claude
#   .env.gpt      — python -m martol_agent --profile gpt
# Each profile file has the same format as this file.
# CLI flags override profile values.

# ── Agent Mode ─────────────────────────────────────────────
# "provider" (default) uses LLM API, "claude-code" uses Claude Code subprocess
AGENT_MODE=provider

# ── Claude Code Mode Settings ──────────────────────────────
# Only used when AGENT_MODE=claude-code

# Model override for Claude Code
CLAUDE_CODE_MODEL=

# Permission mode: default, acceptEdits, bypassPermissions
CLAUDE_CODE_PERMISSION_MODE=default

# Comma-separated list of allowed tools. Defaults to safe read-only set.
# To allow code edits: Read,Grep,Glob,LS,Edit,Write
# To allow everything (DANGEROUS): leave empty and set CLAUDE_CODE_PERMISSION_MODE=bypassPermissions
CLAUDE_CODE_ALLOWED_TOOLS=
